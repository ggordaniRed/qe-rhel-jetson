ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG NVIDIA_CONTAINER_TOOLKIT_VERSION=1.20.1-1

COPY nvidia-container-toolkit.repo /etc/yum.repos.d/nvidia-container-toolkit.repo

RUN dnf install -y \
      "nvidia-container-toolkit-base-${NVIDIA_CONTAINER_TOOLKIT_VERSION}"

# CDI discovery can miss the JetPack library in its RHEL-specific location.
RUN if [ -e /usr/lib64/nvidia/libcuda.so.1 ]; then \
      ln -sf /usr/lib64/nvidia/libcuda.so.1 /usr/lib64/libcuda.so.1 && \
      ln -sf /usr/lib64/nvidia/libcuda.so.1 /usr/lib64/libcuda.so; \
    fi

RUN rm -f /etc/cdi/nvidia.yaml && systemctl enable nvidia-ctk.service
